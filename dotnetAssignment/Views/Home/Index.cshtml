@model AllTouristPlaces
@{
    ViewBag.Title = "Tourist Place List";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentSort = ViewBag.CurrentSort as string ?? "none";
}

@section StylesAndTitle {
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tourist Place List</title>
    <link href="~/css/Index.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container-fluid px-4 pt-4">

    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container-fluid">
            <div class="navbar-brand d-flex align-items-center">
                <img src="~/images/logo.jpg" alt="Logo" class="logo me-2">
                <span class="navbar-title">Tourist Places</span>
            </div>

            <div id="navbarContent">
                <form class="d-flex" id="navbarSearchForm">
                    <input class="form-control search-box" type="search" placeholder="Search by name"
                           aria-label="Search" id="searchInput" name="searchString" value="@currentSearch">
                </form>
            </div>
        </div>
    </nav>


    <!-- Table -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="table-responsive">
                <table class="table list-table mb-0">
                    <thead>
                        <tr>
                            <th>NAME</th>
                            <th>ADDRESS</th>
                            <th class="sortable-header" id="ratingHeader">
                                RATING
                                <span class="sort-arrow @(currentSort == "none" ? "sort-arrow-none" : currentSort == "asc" ? "sort-arrow-up active" : "sort-arrow-down active")"></span>
                            </th>
                            <th>PICTURE</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.touristPlaces.Any())
                        {
                            @foreach (var touristPlace in @Model.touristPlaces)
                            {
                                var photoPath = Url.Content("~/images/" + (touristPlace.PhotoPath ?? "noimage.jpg"));

                                <tr>
                                    <td>@touristPlace.Name</td>
                                    <td>@touristPlace.Address</td>
                                    <td>@touristPlace.Rating</td>
                                    <td class="pic-td">
                                        <img src="@photoPath" asp-append-version="true" alt="Picture" class="place-picture">
                                    </td>
                                    <td class="action-td">
                                        <a asp-controller="Home"
                                           asp-action="UpdateTouristPlace"
                                           asp-route-id="@touristPlace.Id"
                                           asp-route-searchString="@currentSearch"
                                           asp-route-sortOrder="@currentSort"
                                           class="btn btn-update">Update</a>
                                        <a asp-controller="Home"
                                           asp-action="Delete"
                                           asp-route-id="@touristPlace.Id"
                                           asp-route-searchString="@currentSearch"
                                           asp-route-sortOrder="@currentSort"
                                           class="btn btn-delete"
                                           onclick="return confirm('Are you sure you want to delete this place?');">Delete</a>
                                        <a asp-controller="Home"
                                           asp-action="Details"
                                           asp-route-id="@touristPlace.Id"
                                           asp-route-searchString="@currentSearch"
                                           asp-route-sortOrder="@currentSort"
                                           class="btn btn-create">Details</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No tourist places found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create New Tourist Place -->
    <div class="row mt-3">
        <div class="col-auto">
            <a asp-controller="Home"
               asp-action="AddNewTouristPlace"
               asp-route-searchString="@currentSearch"
               asp-route-sortOrder="@currentSort"
               class="btn btn-create">Create New Tourist Place</a>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Current state
        let currentSearch = '@currentSearch';
        let currentSort = '@currentSort';

        // Search-as-you-type functionality
        let searchTimeout;
        const searchInput = document.getElementById('searchInput');
        const ratingHeader = document.getElementById('ratingHeader');

        // Navigate with current parameters
        function navigateWithParams(search, sort) {
            const url = new URL(window.location.origin + '@Url.Action("Index", "Home")');
            if (search) {
                url.searchParams.set('searchString', search);
            }
            if (sort && sort !== 'none') {
                url.searchParams.set('sortOrder', sort);
            }
            window.location.href = url.toString();
        }

        // Search input event listener with debounce
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                navigateWithParams(searchInput.value, currentSort);
            }, 500); // 500ms debounce
        });

        // Allow immediate search on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                clearTimeout(searchTimeout);
                navigateWithParams(searchInput.value, currentSort);
            }
        });

        // Rating column header click for sorting
        ratingHeader.addEventListener('click', function() {
            let newSort;

            // Cycle through: none → asc → desc → none
            if (currentSort === 'none' || currentSort === '') {
                newSort = 'asc';
            } else if (currentSort === 'asc') {
                newSort = 'desc';
            } else {
                newSort = 'none';
            }

            navigateWithParams(currentSearch, newSort);
        });
    </script>
}
